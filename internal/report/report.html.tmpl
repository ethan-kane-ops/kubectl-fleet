<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fleet report</title>
<style>{{.CSS}}
.verdict { display: inline-block; margin: 8px 0 4px; padding: 6px 12px; border-radius: 6px; font-weight: 600; }
.verdict.clear { background: var(--ok-bg); color: var(--ok); }
.verdict.attention { background: var(--bad-bg); color: var(--bad); }
.label { display: inline-block; min-width: 88px; padding: 1px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-align: center; }
.label.bad { background: var(--bad-bg); color: var(--bad); }
.label.warn { background: var(--warn-bg); color: var(--warn); }
.label.info { background: var(--info-bg); color: var(--info); }
.overview th { width: 220px; background: transparent; font-size: 13px; letter-spacing: 0; }
.overview td { white-space: normal; }
details summary { cursor: pointer; font-size: 16px; font-weight: 600; margin: 28px 0 8px; }
</style>
</head>
<body>
<main>
<h1>Fleet report</h1>
<p class="meta">Generated {{.Generated}} &middot; {{.Clusters}}<br>Selection: {{.Selection}}</p>

<p class="verdict {{if .Clear}}clear{{else}}attention{{end}}">{{.Verdict}}</p>
{{- if .Items}}
<div class="scroll">
<table>
<thead><tr><th>Status</th><th>Context</th><th>Detail</th></tr></thead>
<tbody>
{{- range .Items}}
<tr><td><span class="label {{.Class}}">{{.Label}}</span></td><td><code>{{.Context}}</code></td><td>{{.Message}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}

<h2>Fleet overview</h2>
<table class="overview">
<tbody>
{{- range .Overview}}
<tr><th scope="row">{{index . 0}}</th><td>{{index . 1}}</td></tr>
{{- end}}
</tbody>
</table>

<h2>Clusters</h2>
<div class="scroll">
<table>
<thead><tr>{{range .ClusterHeaders}}<th>{{.}}</th>{{end}}</tr></thead>
<tbody>
{{- range .ClusterRows}}
<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>
{{- end}}
</tbody>
</table>
</div>
{{- if .CompRows}}

<details>
<summary>kube-system components</summary>
<div class="scroll">
<table>
<thead><tr>{{range .CompHeaders}}<th>{{.}}</th>{{end}}</tr></thead>
<tbody>
{{- range .CompRows}}
<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>
{{- end}}
</tbody>
</table>
</div>
</details>
{{- end}}
</main>
</body>
</html>
